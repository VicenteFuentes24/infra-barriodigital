# Copy to .env.kafka on the Kafka EC2.
KAFKA_EXTERNAL_BIND=10.0.2.174
KAFKA_EXTERNAL_HOST=10.0.2.174
KAFKA_BROKER_MEM_LIMIT=704m
KAFKA_BROKER_HEAP_OPTS="-Xms128m -Xmx320m"
KAFKA_BROKER_DIRECT_MEMORY=96m
KAFKA_ZK_MEM_LIMIT=224m
KAFKA_ZK_HEAP_OPTS="-Xms64m -Xmx96m"
KAFKA_UI_MEM_LIMIT=384m
KAFKA_UI_JAVA_OPTS="-Xms96m -Xmx192m -XX:MaxDirectMemorySize=48m"
KAFKA_UI_CLUSTER_NAME=barriodigital-aws
