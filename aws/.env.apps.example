# Copy to .env.apps (ignored), chmod 600. Never commit actual values.
# Confirm the current API Gateway -> EC2 HTTP integration BEFORE changing this bind.
# EC2 public IPv4 is NAT: bind its PRIVATE IP (not its Elastic IP), or 0.0.0.0 with restrictive SG.
BFF_BIND_ADDRESS=127.0.0.1
BFF_PORT=8080
AZURE_TENANT_ID=
AZURE_API_AUDIENCE=
FRONTEND_ORIGIN=

# Existing Supabase JDBC URLs must include sslmode=require. Schemas must already exist.
REQUESTS_DB_URL=
REQUESTS_DB_USERNAME=
REQUESTS_DB_PASSWORD=
CATALOG_DB_URL=
CATALOG_DB_USERNAME=
CATALOG_DB_PASSWORD=
DB_POOL_SIZE=3

RABBITMQ_ADDRESSES=10.0.1.62:5672,10.0.2.151:5672
# Existing accounts on vhost barriodigital. Separate least-privilege accounts are recommended.
REQUESTS_RABBITMQ_USERNAME=
REQUESTS_RABBITMQ_PASSWORD=
NOTIFY_RABBITMQ_USERNAME=
NOTIFY_RABBITMQ_PASSWORD=
ADMIN_RABBITMQ_USERNAME=
ADMIN_RABBITMQ_PASSWORD=
# HTTP Basic account is DIFFERENT from all broker/database accounts. Minimum 16 characters.
ADMIN_HTTP_USERNAME=
ADMIN_HTTP_PASSWORD=

SMTP_FROM=no-reply@barriodigital.test
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_RETRY_DELAY_MS=1000
NOTIFY_VOLUME_NAME=barriodigital-aws-notify-data
MAILPIT_VOLUME_NAME=barriodigital-aws-mailpit-data
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=1000
AWS_APPS_NETWORK_NAME=barriodigital-apps-aws
# Future services are NOT created here. Existing BFF returns 503 while unavailable.
REPORT_SERVICE_URL=http://report:8083
AUDIT_SERVICE_URL=http://audit:8084
