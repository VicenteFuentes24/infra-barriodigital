# Copy to .env.node1 OUTSIDE Git. Retain existing credentials and cookie.
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
RABBITMQ_NODE1_PRIVATE_IP=10.0.1.62
RABBITMQ_NODE2_PRIVATE_IP=10.0.2.151
RABBITMQ_DATA_DIR=/home/ec2-user/barriodigital-rabbitmq/data
# Absolute path to the ALREADY EXISTING shared cookie, UID/GID 999, mode 0400 or 0600.
# It may already be RABBITMQ_DATA_DIR/.erlang.cookie; do not replace or regenerate it.
RABBITMQ_COOKIE_FILE=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
