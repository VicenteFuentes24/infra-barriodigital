# Copiar como .env.rabbitmq y definir credenciales solo para RabbitMQ local.
# No reutilizar credenciales Azure, Supabase ni de otros proyectos.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Imagenes con version fija; se admite una referencia por digest.
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
RABBITMQ_TOPOLOGY_IMAGE=curlimages/curl:8.21.0

# Puertos del host, publicados solo en 127.0.0.1.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Nombre generado por compose.yml cuando su proyecto es infra-barriodigital.
# Usar el nombre real si la evaluacion anterior se inicia con otro -p.
BARRIODIGITAL_NETWORK_NAME=infra-barriodigital_barriodigital-net
